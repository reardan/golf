# ---------------------------------------------------------------------------
# The token dispatcher
# ---------------------------------------------------------------------------
#
# `t` takes the current char and is an if-chain: each case dups the char, tests
# it, and returns from inside the case.  Every handler is stack-neutral EXCEPT
# `:` `[` `{`, which each leave one backpatch address behind, and `;` `]` `}`,
# which each consume one.  The main loop is stack-neutral, so those pending
# addresses stack up harmlessly below and are consumed in LIFO order: the data
# stack *is* the compile-time backpatch stack.

:t
"
33<
1+
[           # char <= 32 : whitespace
_
^
]

"
35-
[           # '#' : a comment line
_
h
^
]

"
U
1+
[           # '0'..'9' : a decimal literal
48-         #   seed the accumulator with this digit
{
(           #   read the next char
"
U
[           #   not a digit: the number ends here
→q          #     push the terminator back for the main loop
W           #     emit the push — imm32, or mov rax,imm64 past 2^31-1
^
]
Z           #   fold the digit in
0
}
]

"
39-
[           # 39 is the quote: a char literal, emitted as push imm32 <next byte>
_
(
L
w
^
