[           #   link 3: the shape is known — emit the fork
←b
→I
←F
X           #     ′f
←G
X           #     ′g
←I
X           #     ′h
199
e           #     ⑂ : h(f x, g x).  An ordinary prelude word, so an ordinary call
^
]
←b
e           #   link 4 and later: a plain call, applied to what the fork left
^
]

e           # anything else: a table op or a call to a defined word
;


# ---------------------------------------------------------------------------
# The ELF header
# ---------------------------------------------------------------------------

# Blob record 4 holds the header's NON-ZERO bytes only, as (offset, value)
# pairs: the output buffer is BSS, so the ~80% of the header that is zero is
# already correct and only the pairs have to be painted in.

:H          # H : paint the ELF header over the zeroed output buffer  [ -> ]
4
f           # find record 4
→R
←R
1+
?           # its length ...
←R
2+
+           # ... gives the address one past its last pair
→z
←R
2+
→A          # walk the pairs from the first
{
←A
1+
?           # the byte's value ...
←A
?
B
+           # ... and where it belongs in the output buffer
,
←A
2+
→A
←A
←z
<
1+          # loop while there are pairs left
}
;


# ---------------------------------------------------------------------------
# The template blob.  The build replaces the marker line below with the raw
# blob escape.  That escape compiles to a jmp over the raw data plus a push of
# the data's address, so the main program that follows starts with the template
# table's address on the stack — and every definition above, being a jmp-over,
# is skipped at run time.
# ---------------------------------------------------------------------------

@BLOB@


# ---------------------------------------------------------------------------
# The main program.  It runs first: every definition above is a jmp-over.
# ---------------------------------------------------------------------------

→T          # the blob escape just pushed the template table's address
H           # paint the ELF header into the (zeroed) buffer
B
120+
→p          # code begins right after the 120-byte header
3E          # blob record 3: the startup stub, mov ebp,0x600000 (RSTACK_TOP)

{           # the token loop:
g           #   fetch a char (a pushed-back one first)
"
→i          #   remember it as the current char
t           #   compile it
←i
1<          #   loop while it is not 0, i.e. until EOF
}

5E          # blob record 5: exit(0)

B
→A          # flush the buffer to stdout, one byte at a time
{
←A
?
)
←A
1+
→A
←A
←p
<
1+          # loop while the cursor is below the write pointer
}
