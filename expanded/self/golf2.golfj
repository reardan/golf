# ---------------------------------------------------------------------------
# The ELF header
# ---------------------------------------------------------------------------

# Blob record 4 holds the header's NON-ZERO bytes only, as (offset, value)
# pairs: the output buffer is BSS, so the ~80% of the header that is zero is
# already correct and only the pairs have to be painted in.

:H          # H : paint the ELF header over the zeroed output buffer  [ -> ]
4
f           # find record 4
→R
←R
1+
?           # its length ...
←R
2+
+           # ... gives the address one past its last pair
→z
←R
2+
→A          # walk the pairs from the first
{
←A
1+
?           # the byte's value ...
←A
?
B
+           # ... and where it belongs in the output buffer
,
←A
2+
→A
←A
←z
<
1+          # loop while there are pairs left
}
;


