[           # 0xB0 ⊚ : define a word as a tacit CHAIN of links
_           #   the header is ':'s, plus the two state cells
(           #   its name is the next byte
→b
233o        #   0xE9 = jmp over the body about to be compiled
←p
4+          #   the body begins after the 4-byte jmp displacement
←b
