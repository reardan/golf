131o        #   return address, which is therefore at [rbp+64] from here on
237o
64o
1→J         #   this definition has a frame; '^' and ';' release it
^
]

"
178-
[           # 0xB2 ⇒ : pop TOS into a local slot
_
(           #   the name is the next byte
→b          #   keep it for the diagnostic below
←b
97-         #   'a' is slot 0 ...
"
8<          #   ... and there are only eight.  Unchecked, ⇒z would be disp 200,
[           #   which is a NEGATIVE disp8 (-56) and would land in the frame of
            #   a word not yet called; ⇒A would wrap to disp 0 and silently
            #   alias slot a.  Both are the kind of quiet corruption M-DIAG
            #   exists to refuse, so an out-of-range name stops the compile.
“GOLF: local out of range “
V
]
8*          #   a slot is 8 bytes, so this is the displacement off rbp
88o         #   0x58                 pop rax
72o         #   0x48 0x89 0x45 disp  mov [rbp+disp], rax
137o
69o
o           #   the displacement, which fits a disp8 for every legal slot
^
]

