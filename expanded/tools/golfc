#!/usr/bin/env bash
# golfc — compile a GOLF/2 program to an executable, with the list prelude.
#
#   golfc PROG.g2  OUT      # PROG is raw code-page bytes
#   golfc -j PROG.golfj OUT # PROG is glyph/\mnemonic source (encoded first)
#   golfc -n PROG OUT       # no prelude (bare program)
#
# Builds the toolchain (v1c -> golf2) once into expanded/build/ and reuses it.
set -eu
HERE=$(cd "$(dirname "$0")/.." && pwd)          # expanded/
MIN="$HERE/../minimal"
BUILD="$HERE/build"; mkdir -p "$BUILD"
GOLF2="$BUILD/golf2"

# (re)build golf2 if missing or stale. self/golf2.golf is *generated* by
# tools/mkblob2.py, so an edit to mkblob2.py is a source change too and has to be
# part of the staleness test. mkblob2.py rewrites self/golf2.golf unconditionally,
# so its mtime is only meaningful before we regenerate — hence the check first,
# the regeneration inside.
if [ ! -x "$GOLF2" ] || [ "$HERE/self/golf2.golf" -nt "$GOLF2" ] \
   || [ "$HERE/tools/mkblob2.py" -nt "$GOLF2" ]; then
  python3 "$HERE/tools/mkblob2.py"                # refresh the generated v2 seed
  python3 "$MIN/boot/golf0.py" < "$MIN/self/golf.golf" > "$BUILD/v1c"; chmod +x "$BUILD/v1c"
  "$BUILD/v1c" < "$HERE/self/golf2.golf" > "$GOLF2"; chmod +x "$GOLF2"
fi

prelude="$HERE/lib/prelude.golfj"; encode=""; noprelude=""
while [ $# -gt 0 ]; do
  case "$1" in
    -j) encode=1; shift;;
    -n) noprelude=1; shift;;
    *) break;;
  esac
done
prog=$1; out=$2
src=$(mktemp)
cp="python3 $HERE/tools/codepage.py encode"
[ -z "$noprelude" ] && $cp < "$prelude" >> "$src"     # prelude is code-page source
if [ -n "$encode" ]; then $cp < "$prog" >> "$src"
else cat "$prog" >> "$src"; fi
"$GOLF2" < "$src" > "$out"; chmod +x "$out"
rm -f "$src"
