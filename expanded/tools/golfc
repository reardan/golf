#!/usr/bin/env bash
# golfc — compile a GOLF/2 program to an executable, with the list prelude.
#
#   golfc PROG.g2  OUT      # PROG is raw code-page bytes
#   golfc -j PROG.golfj OUT # PROG is glyph/\mnemonic source (encoded first)
#   golfc -n PROG OUT       # no prelude (bare program)
#   golfc -g ... PROG OUT   # also write OUT.map: one `name 0xaddr` per word
#   golfc -P ... PROG OUT   # the WHOLE prelude (also GOLFC_FULL=1)
#
# W13-I: without -P only the prelude definitions the program can reach are
# compiled (tools/golfprune.py; REFERENCE "Prelude pruning").  A program that
# reaches a prelude word only through an address it computes at run time needs
# -P; everything named in the source — calls, ′ quotes, adverbs, chains,
# digraphs, includes — is seen.
#
# Flags combine (-j -g, -n -g, ...).  A compile error is `GOLF: <what> at line
# N` (or `at FILE line N` inside an included file), exit 2 (W11-3B): N is a
# line of YOUR file, because golfc puts a form feed — which restarts golf2's
# line count — between the prelude and the program, and names an included
# .golfj by its own path rather than the encoded temp copy golf2 actually read.
#
# -g (W11-3B): golf2 -g writes the symbol map to fd 2 once the compile has
# succeeded; golfc saves it as OUT.map, one line per defined word, in name-number
# order (one-byte names by byte value, then long names in order of first
# appearance; a word defined twice shows its last body):
#
#     NAME 0xADDR
#
# NAME is the word as the source spells it — a glyph, an ASCII letter or
# `‹long›`; ADDR is the runtime virtual address of the word's body, in hex
# (file offset + 0x400000, the program's one PT_LOAD).  The prelude's words
# are listed too.  The binary is byte-identical with and without -g.
#
# `⎘“path“` includes resolve against the current directory, then lib/ (W11-2A),
# then vendor/ (W11-4A, where tools/golfdeps fetches packages);
# an included .golfj is encoded on the way, a .g2 is read raw.
#
# Walks the bootstrap ladder once into expanded/build/ and reuses the result:
#
#   v1c (pinned, ../SEEDS) -> seed (self/seed.golf) -> golf2 (self/golf2.golf)
#
set -eu
HERE=$(cd "$(dirname "$0")/.." && pwd)          # expanded/
SEED_ROOT=$(cd "$HERE/.." && pwd)               # repo root: ./SEEDS, ./v1c
. "$HERE/tools/seed.sh"
BUILD="$HERE/build"; mkdir -p "$BUILD"
GOLF2="$BUILD/golf2"

# (re)build golf2 if missing or stale.  BOTH self/*.golf are *generated* by
# tools/mkblob2.py, so the files a human actually edits are the real sources:
#   self/golf2.golfj  the compiler's logic, written in v2 GOLF  (since M-SELF)
#   self/seed.golfv1  the same compiler in v1 GOLF, the bootstrap rung
#   data/ops.tsv      the code page: every op byte's mnemonic and glyph (W14-L)
#   data/templates.txt the template blob, in its small notation (W14-L)
#   tools/mkblob2.py  the reader of both, and the memory map
#   tools/codepage.py the encoder that turns golf2.golfj into golf2.golf
# An edit to any of them is a source change. The generated files are listed too,
# so a stray hand-edit is not silently ignored — but mkblob2.py rewrites them
# unconditionally, so their mtimes only mean anything BEFORE we regenerate:
# hence the whole check first, the regeneration inside.
stale=""
[ -x "$GOLF2" ] || stale=1
for s in self/golf2.golfj self/seed.golfv1 tools/mkblob2.py tools/codepage.py \
         data/ops.tsv data/templates.txt self/seed.golf self/golf2.golf; do
  if [ "$HERE/$s" -nt "$GOLF2" ]; then stale=1; fi
done
if [ -n "$stale" ]; then
  python3 "$HERE/tools/mkblob2.py"                # refresh both generated sources
  ensure_seed v1c
  "$SEED"        < "$HERE/self/seed.golf"  > "$BUILD/seed"; chmod +x "$BUILD/seed"
  "$BUILD/seed"  < "$HERE/self/golf2.golf" > "$GOLF2";      chmod +x "$GOLF2"
fi

prelude="$HERE/lib/prelude.golfj"; encode=""; noprelude=""; gflag=""
full="${GOLFC_FULL:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    -j) encode=1; shift;;
    -n) noprelude=1; shift;;
    -g) gflag=-g; shift;;
    -P) full=1; shift;;
    *) break;;
  esac
done
prog=$1; out=$2
src=$(mktemp); body=$(mktemp)
incs=$(mktemp -d); trap 'rm -rf "$src" "$body" "$incs"' EXIT
if [ -n "$encode" ]; then python3 "$HERE/tools/codepage.py" encode < "$prog" > "$body"
else cat "$prog" > "$body"; fi
# W11-2A: `⎘“path“` makes golf2 read that file's bytes as they are — raw code
# page, the form fd 0 carries.  A `.golfj` include is glyph source, so it is
# encoded here first, like the program itself: each ⎘“x.golfj“ that resolves
# (as written, then lib/x.golfj, then vendor/x.golfj — golf2's search) is rewritten to name an
# encoded copy in a temp dir, recursively, one copy per real file (so
# include-once still holds).  A path that resolves to nothing is left alone
# and golf2 reports it under its own name.  Any other path is untouched.
# The temp copy -> path-as-written table goes to $incs/names, so that a
# diagnostic inside an included .golfj names the user's file (W11-3B).
#
# W13-I: the same pass then puts the prelude in front — only the part the
# program reaches (tools/golfprune.py: every definition whose name the
# program, its includes, the prelude's top-level code or another kept
# definition mentions; the rest leave just their newlines).  -P, or
# GOLFC_FULL=1, keeps the whole prelude; -n puts none.
python3 - "$src" "$incs" "$HERE/tools" "$body" "${noprelude:+none}${full:+full}" \
          "$prelude" "$BUILD" <<'PY'
import os, re, sys
src, incs, body, mode, prelude, build = (sys.argv[1], sys.argv[2], sys.argv[4],
                                         sys.argv[5], sys.argv[6], sys.argv[7])
sys.path.insert(0, sys.argv[3]); import codepage
done = {}
scanned = []                   # every byte string golf2 will compile
def fix(data):
    scanned.append(data)
    def one(m):
        p = m.group(1)
        for cand in (p, b"lib/" + p, b"vendor/" + p):
            if os.path.isfile(cand):
                break
        else:
            return m.group(0)
        key = os.path.realpath(cand)
        if not p.endswith(b".golfj"):          # a raw include: scan it as is
            if key not in done:
                done[key] = None
                with open(cand, "rb") as f:
                    fix(f.read())
            return m.group(0)
        if key not in done:
            done[key] = os.path.join(incs, "%d.g2" % len(done)).encode()
            with open(cand, encoding="utf-8") as f:
                enc = fix(codepage.encode(f.read()))
            with open(done[key], "wb") as f:
                f.write(enc)
            with open(os.path.join(incs, "names"), "ab") as f:
                f.write(done[key] + b"\0" + p + b"\0")
        return b"\xb6\x8e" + done[key] + b"\x8e"
    return re.sub(rb"\xb6\x8e([^\x8e]*)\x8e", one, data)
with open(body, "rb") as f:
    prog = fix(f.read())
with open(src, "wb") as f:
    if mode != "none":
        # The encoded prelude is cached in build/, keyed by the hash of what
        # it is made from (lib/prelude.golfj and the code page).
        import hashlib
        h = hashlib.sha1()
        for d in (prelude, os.path.join(sys.argv[3], "codepage.py"),
                  os.path.join(sys.argv[3], "mkblob2.py"),
                  os.path.join(sys.argv[3], "..", "data", "ops.tsv")):
            with open(d, "rb") as g:
                h.update(g.read())
        cache = os.path.join(build, "prelude.gb")
        key = h.hexdigest().encode() + b"\n"
        try:
            with open(cache, "rb") as g:
                pre = g.read()
        except OSError:
            pre = b""
        if pre.startswith(key):
            pre = pre[len(key):]
        else:
            with open(prelude, encoding="utf-8") as g:
                pre = codepage.encode(g.read())
            tmp = cache + ".%d" % os.getpid()
            with open(tmp, "wb") as g:
                g.write(key + pre)
            os.replace(tmp, cache)
        if mode != "full":
            import golfprune
            roots = set()
            for d in scanned:
                roots |= golfprune.refs(d)
            pre = golfprune.prune(pre, roots)
        f.write(pre)
        f.write(b"\f")       # W11-3B: line 1 of the program is line 1 again
    f.write(prog)
PY
rc=0; "$GOLF2" $gflag < "$src" > "$out" 2> "$incs/err" || rc=$?
python3 - "$incs" "$rc" "$out" "$HERE/tools" "$gflag" <<'PY'
import os, sys
incs, rc, out = sys.argv[1], int(sys.argv[2]), sys.argv[3]
sys.path.insert(0, sys.argv[4]); import codepage
err = open(os.path.join(incs, "err"), "rb").read()
if rc:                     # a diagnostic: put the user's include names back
    try:
        f = open(os.path.join(incs, "names"), "rb").read().split(b"\0")
    except OSError:
        f = []
    for tmp, orig in zip(f[0::2], f[1::2]):
        err = err.replace(b" at " + tmp + b" line ", b" at " + orig + b" line ")
    sys.stderr.buffer.write(err)
elif sys.argv[5]:          # -g: the map, with each one-byte name as its glyph
    lines = []
    for ln in err.split(b"\n")[:-1]:
        name, addr = ln.rsplit(b" ", 1)
        if not name.startswith("‹".encode()):
            name = codepage.decode(name).encode("utf-8", "surrogateescape")
        lines.append(name + b" " + addr + b"\n")
    with open(out + ".map", "wb") as f:
        f.writelines(lines)
PY
[ "$rc" = 0 ] || exit "$rc"
chmod +x "$out"
