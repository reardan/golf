#!/usr/bin/env bash
# golfc — compile a GOLF/2 program to an executable, with the list prelude.
#
#   golfc PROG.g2  OUT      # PROG is raw code-page bytes
#   golfc -j PROG.golfj OUT # PROG is glyph/\mnemonic source (encoded first)
#   golfc -n PROG OUT       # no prelude (bare program)
#
# `⎘“path“` includes resolve against the current directory, then lib/ (W11-2A);
# an included .golfj is encoded on the way, a .g2 is read raw.
#
# Walks the bootstrap ladder once into expanded/build/ and reuses the result:
#
#   v1c (pinned, ../SEEDS) -> seed (self/seed.golf) -> golf2 (self/golf2.golf)
#
set -eu
HERE=$(cd "$(dirname "$0")/.." && pwd)          # expanded/
SEED_ROOT=$(cd "$HERE/.." && pwd)               # repo root: ./SEEDS, ./v1c
. "$HERE/tools/seed.sh"
BUILD="$HERE/build"; mkdir -p "$BUILD"
GOLF2="$BUILD/golf2"

# (re)build golf2 if missing or stale.  BOTH self/*.golf are *generated* by
# tools/mkblob2.py, so the files a human actually edits are the real sources:
#   self/golf2.golfj  the compiler's logic, written in v2 GOLF  (since M-SELF)
#   self/seed.golfv1  the same compiler in v1 GOLF, the bootstrap rung
#   tools/mkblob2.py  the template blob and the atom table
#   tools/codepage.py the encoder that turns golf2.golfj into golf2.golf
# An edit to any of them is a source change. The generated files are listed too,
# so a stray hand-edit is not silently ignored — but mkblob2.py rewrites them
# unconditionally, so their mtimes only mean anything BEFORE we regenerate:
# hence the whole check first, the regeneration inside.
stale=""
[ -x "$GOLF2" ] || stale=1
for s in self/golf2.golfj self/seed.golfv1 tools/mkblob2.py tools/codepage.py \
         self/seed.golf self/golf2.golf; do
  if [ "$HERE/$s" -nt "$GOLF2" ]; then stale=1; fi
done
if [ -n "$stale" ]; then
  python3 "$HERE/tools/mkblob2.py"                # refresh both generated sources
  ensure_seed v1c
  "$SEED"        < "$HERE/self/seed.golf"  > "$BUILD/seed"; chmod +x "$BUILD/seed"
  "$BUILD/seed"  < "$HERE/self/golf2.golf" > "$GOLF2";      chmod +x "$GOLF2"
fi

prelude="$HERE/lib/prelude.golfj"; encode=""; noprelude=""
while [ $# -gt 0 ]; do
  case "$1" in
    -j) encode=1; shift;;
    -n) noprelude=1; shift;;
    *) break;;
  esac
done
prog=$1; out=$2
src=$(mktemp)
cp="python3 $HERE/tools/codepage.py encode"
[ -z "$noprelude" ] && $cp < "$prelude" >> "$src"     # prelude is code-page source
if [ -n "$encode" ]; then $cp < "$prog" >> "$src"
else cat "$prog" >> "$src"; fi
# W11-2A: `⎘“path“` makes golf2 read that file's bytes as they are — raw code
# page, the form fd 0 carries.  A `.golfj` include is glyph source, so it is
# encoded here first, like the program itself: each ⎘“x.golfj“ that resolves
# (as written, then lib/x.golfj — golf2's search) is rewritten to name an
# encoded copy in a temp dir, recursively, one copy per real file (so
# include-once still holds).  A path that resolves to nothing is left alone
# and golf2 reports it under its own name.  Any other path is untouched.
incs=$(mktemp -d); trap 'rm -rf "$src" "$incs"' EXIT
python3 - "$src" "$incs" "$HERE/tools" <<'PY'
import os, re, sys
src, incs = sys.argv[1], sys.argv[2]
sys.path.insert(0, sys.argv[3]); import codepage
done = {}
def fix(data):
    def one(m):
        p = m.group(1)
        if not p.endswith(b".golfj"):
            return m.group(0)
        for cand in (p, b"lib/" + p):
            if os.path.isfile(cand):
                break
        else:
            return m.group(0)
        key = os.path.realpath(cand)
        if key not in done:
            done[key] = os.path.join(incs, "%d.g2" % len(done)).encode()
            with open(cand, encoding="utf-8") as f:
                enc = fix(codepage.encode(f.read()))
            with open(done[key], "wb") as f:
                f.write(enc)
        return b"\xb6\x8e" + done[key] + b"\x8e"
    return re.sub(rb"\xb6\x8e([^\x8e]*)\x8e", one, data)
with open(src, "rb") as f:
    data = f.read()
with open(src, "wb") as f:
    f.write(fix(data))
PY
"$GOLF2" < "$src" > "$out"; chmod +x "$out"
