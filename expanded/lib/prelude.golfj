  "1048576\radd5177396@\radd\brk 5177396@\rsub5177400!]H!;
:L\fetch;                                           # L: len(list)
:I8\rmul\radd8\radd\fetch;                          # I: index(list,i)
:R X"1\radd A"5177440\store\store0 5177448\store5177440\fetch\fetch0\eq[{5177448\fetch"8\rmul5177440\fetch\radd8\radd\store5177448\fetch1\radd5177448\store5177448\fetch5177440\fetch\fetch\rlt1\radd}]5177440\fetch Y;
:S X5177440\store0 5177456\store0 5177448\store5177440\fetch\fetch0\eq[{5177440\fetch5177448\fetch I5177456\fetch+5177456\store5177448\fetch1\radd5177448\store5177448\fetch5177440\fetch\fetch\rlt1\radd}]5177456\fetch Y;
# N: print signed decimal.  W4A added the sign check — cells hold negatives now,
# so `-5 N` must print -5 and not 2^64-5.  `"0\slt1\radd[…]` runs the block only
# when n <s 0: emit '-' (45) and \neg, then fall into the unsigned recursion.
# The recursive call sees n/10 >= 0, so the check costs one compare per digit.
