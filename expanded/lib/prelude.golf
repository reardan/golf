# GOLF/2 prelude — list runtime + number printing.
# Prepend to any program that uses lists:  cat prelude.golf prog | golf2
#
# A list is a heap block of 32-bit cells [ len, e0, e1, ... ]; a list value is
# its address.  Reserved runtime memory (do not use these addresses in your
# program): heap pointer at 0x4F0000, scratch at 0x4F0010.., heap from 0x500000.
#
# Words (single-byte names — avoid reusing H A L I R S N E in your program):
#   A cells->addr   allocate     L list->n     length      I list i->x   index
#   R n->list       range 0..n-1  S list->sum   sum         N n->         print uint
#   E ->            newline
:H5177344;                         # H: address of the heap pointer (bump offset)
:A4*H@5242880+\H@+H!;              # A: alloc(cells) -> addr  (bump the heap)
:L@;                               # L: len(list) -> n   (length is cell 0)
:I4*+4+@;                          # I: index(list,i) -> elem
:R"1+A"5177360!!0 5177364!{5177364@"4*5177360@+4+!5177364@1+5177364!5177364@5177360@@<1+}5177360@;
:S5177360!0 5177368!0 5177364!{5177360@5177364@I5177368@+5177368!5177364@1+5177364!5177364@5177360@@<1+}5177368@;
:N"10<1+[48+)^]"10/N10%48+);       # N: print unsigned decimal
:E10);                             # E: newline
