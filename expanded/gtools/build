#!/usr/bin/env bash
# gtools/build — compile a GOLF-written build tool.
#
#   gtools/build gtools/encode.golfj build/gencode
#
# This is tools/golfc plus the tool libraries.  A program under gtools/ is
# compiled as:
#
#     lib/prelude.golfj  +  lib/t*.golfj  +  the program
#
# all code-page encoded and concatenated, then fed to the bootstrapped golf2 —
# the prelude pruned to what the libraries and the program reach (W14-L).
# The prelude comes first because the tool libraries are written on top of it
# (A, X/Y, N, the raw atoms); the libraries come before the program because GOLF
# requires definition before use.
#
# Library order among lib/t*.golfj is glob order, which is also dependency
# order by construction: ttext (pure byte math) <- tio (I/O, uses ttext) is
# wrong alphabetically, so any cross-library dependency must go through a word
# defined in the EARLIER file.  Keep the libraries independent of each other;
# if that ever stops being possible, list them explicitly here instead.
set -eu
HERE=$(cd "$(dirname "$0")/.." && pwd)          # expanded/
BUILD="$HERE/build"; mkdir -p "$BUILD"

[ $# -eq 2 ] || { echo "usage: gtools/build PROG.golfj OUT" >&2; exit 2; }
prog=$1; out=$2

# Reuse golfc's ladder: -n compiles a bare program, so ask it to build nothing
# and just make sure build/golf2 is fresh.  (golfc rebuilds the ladder itself
# when any compiler source is newer than build/golf2.)
"$HERE/tools/golfc" -n /dev/null "$BUILD/.gtools-ladder" >/dev/null 2>&1 || true
GOLF2="$BUILD/golf2"
[ -x "$GOLF2" ] || { echo "gtools/build: $GOLF2 missing (ladder failed)" >&2; exit 1; }

src=$(mktemp); trap 'rm -f "$src"' EXIT
# W14-L: only the prelude the tool can reach, as tools/golfc compiles a program
# (tools/golfprune.py: the roots are every name the tool libraries and the
# program mention).  A tool here is built with the WHOLE prelude in view, and
# the prelude only grows, so without this every tool would carry all of it and
# the largest would meet the 192 KB program cap.
python3 - "$HERE" "$prog" "$src" <<'PY'
import glob, os, sys
here, prog, src = sys.argv[1:]
sys.path.insert(0, os.path.join(here, "tools"))
import codepage, golfprune
def enc(path):
    with open(path, encoding="utf-8") as f:
        return codepage.encode(f.read())
libs = b"".join(enc(p) for p in sorted(glob.glob(os.path.join(here, "lib", "t*.golfj"))))
body = enc(prog)
pre = golfprune.prune(enc(os.path.join(here, "lib", "prelude.golfj")),
                      golfprune.refs(libs) | golfprune.refs(body))
with open(src, "wb") as f:
    # W11-3B: as in tools/golfc, compile errors count lines from the program
    f.write(pre + libs + b"\f" + body)
PY

"$GOLF2" < "$src" > "$out"
chmod +x "$out"
